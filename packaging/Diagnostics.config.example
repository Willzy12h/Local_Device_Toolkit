# Local Device Toolkit: diagnostic selection only. UTF-8 text.
# No device settings, repairs or deployments are changed.
# Copy to Diagnostics.config, edit, then pass --config Diagnostics.config.
# 0 = ignore/skip this item.
# 2 = report its current value; do not change it.
# 1 = request a change: REFUSED by diagnostics. No apply command is included.
# Items omitted from a supplied config are skipped. Without a config, all diagnostics run.
# Unknown keys, duplicate items and other values fail with exit 64.
# all/fast keep ordinary short waits. fast skips only marked timed performance tests.
# No such timed performance tests are currently shipped.
# Check targets are separate: --inputs ProbeInputs.json (see example).
# Reports/logs remain local under %LOCALAPPDATA%/LocalDeviceToolkit/logs.

# Windows version
readiness.os-version=2

# Secure Boot
readiness.secure-boot=2

# TPM readiness
readiness.tpm=2

# BitLocker protection
readiness.bitlocker=2

# Code integrity
readiness.code-integrity=2

# Antivirus protection
readiness.antivirus=2

# BitLocker and recovery escrow
control.cfg-win-001=2

# Windows LAPS
control.cfg-win-002=2

# Windows Hello for Business
control.cfg-win-003=2

# Windows core restrictions
control.cfg-win-004=2

