<Window x:Class="LocalDeviceToolkit.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Local Device Toolkit" FontFamily="Segoe UI" FontSize="14" Width="1280" Height="860" MinWidth="900" MinHeight="480">
 <DockPanel>
  <Border DockPanel.Dock="Top" Padding="24,18" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="LOCAL DEVICE TOOLKIT" FontWeight="Bold" FontSize="22"/><TextBlock x:Name="DeviceHeader" Margin="0,6,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="20,0,0,0"><TextBlock x:Name="StandardHeader"/><TextBlock Text="Local Windows device • engineer session" Margin="0,6,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Border DockPanel.Dock="Bottom" Padding="20,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
   <StackPanel><TextBox x:Name="LiveLog" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" AutomationProperties.Name="Live check and change log"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusLine" Text="Ready. Select a workspace; checks run only when requested." VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="QueueShortcut" Content="Selected changes (0)" Click="Queue_Click" Margin="12,0,0,0"/></Grid></StackPanel>
  </Border>
  <Border DockPanel.Dock="Left" Width="195" Padding="14,24" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="WORKSPACES" FontWeight="SemiBold" Margin="10,0,0,16"/><ToggleButton x:Name="NavHome" Style="{StaticResource NavigationButton}" Content="_Home" Tag="home" Click="Navigate_Click"/><ToggleButton x:Name="NavSetup" Style="{StaticResource NavigationButton}" Content="New device _setup" Tag="setup" Click="Navigate_Click"/><ToggleButton x:Name="NavDiagnostics" Style="{StaticResource NavigationButton}" Content="_Diagnostics" Tag="diagnostics" Click="Navigate_Click"/><ToggleButton x:Name="NavDeployments" Style="{StaticResource NavigationButton}" Content="Deplo_yments" Tag="deployments" Click="Navigate_Click"/><ToggleButton x:Name="NavReports" Style="{StaticResource NavigationButton}" Content="_Reports &amp; history" Tag="reports" Click="Navigate_Click"/><Separator Margin="0,16"/><TextBlock Text="Checks collect evidence. Changes require a reviewed plan." Margin="10,0"/><TextBlock x:Name="SessionNotice" Margin="10,20,0,0"/></StackPanel></ScrollViewer>
  </Border>
  <ScrollViewer x:Name="WorkspaceViewport" Margin="24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid MinHeight="720" Height="{Binding ViewportHeight, ElementName=WorkspaceViewport}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel><TextBlock x:Name="PageTitle" Text="Your device workspace" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageDescription" Margin="0,8,0,18"/></StackPanel>
   <ProgressBar x:Name="Busy" Grid.Row="1" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,12"/>
   <ScrollViewer x:Name="HomePanel" Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" HorizontalAlignment="Left">
    <Border BorderThickness="1" Padding="24" Margin="0,0,0,18" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"><StackPanel><TextBlock Text="Set up a new device" FontSize="22" FontWeight="SemiBold"/><TextBlock Margin="0,12" Text="Identify the device, assess the build standard, configure Windows, deploy approved applications and collect handover evidence."/><Button Content="Open new device setup" Tag="setup" Click="Navigate_Click" HorizontalAlignment="Left"/></StackPanel></Border>
    <Border BorderThickness="1" Padding="24" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"><StackPanel><TextBlock Text="Investigate an existing device" FontSize="22" FontWeight="SemiBold"/><TextBlock Margin="0,12" Text="Check device health, security, applications and user settings. Review the same fixes and deployment queue used during setup."/><Button Content="Open diagnostics" Tag="diagnostics" Click="Navigate_Click" HorizontalAlignment="Left"/></StackPanel></Border>
    <TextBlock Margin="0,20" Text="Both workspaces use one task catalogue and shared evidence. Manual and unavailable checks remain visible; opening a page never changes the device."/>
   </StackPanel></ScrollViewer>
   <Grid x:Name="WorkflowPanel" Grid.Row="2" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock x:Name="StageProgress" Margin="0,0,0,10"/><ComboBox x:Name="Stages" DisplayMemberPath="Title" SelectionChanged="Stage_Changed" AutomationProperties.Name="Workflow stage" Margin="0,0,0,12"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><Label Content="_Find a task by title or control ID" Target="{Binding ElementName=Search}" Padding="0,0,0,6"/><TextBox x:Name="Search" TextChanged="Search_Changed" AutomationProperties.Name="Find tasks by title or control ID" ToolTip="Find tasks by title or control ID"/></StackPanel><Button Grid.Column="1" x:Name="CheckStage" Content="Check and review" Click="CheckStage_Click" VerticalAlignment="Bottom" Margin="0"/></Grid>
    <Grid Grid.Row="2" x:Name="DiagnosticLayout"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" MinWidth="300"/><ColumnDefinition Width="20"/><ColumnDefinition Width="1*" MinWidth="300"/></Grid.ColumnDefinitions>
     <ListBox x:Name="TaskList" SelectionChanged="Task_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Shared toolkit tasks">
      <ListBox.ItemTemplate><DataTemplate><Border Padding="10,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"><StackPanel><CheckBox Content="Select check" IsChecked="{Binding Selected, Mode=TwoWay}" Click="Selection_Changed"/><TextBlock Text="{Binding Definition.Title}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding Status}" Margin="0,6,0,0"/><TextBlock Text="{Binding Account}" FontSize="12" Margin="0,4,0,0"/><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="Action: " FontSize="12"/><TextBlock Text="{Binding ActionLabel}" FontSize="12" FontWeight="SemiBold"/></StackPanel></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock x:Name="TaskTitle" Text="Select a task" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="TaskIds" Margin="0,8,0,14"/><TextBlock x:Name="TaskRequirement"/><TextBlock Text="Local coverage and verification" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8"/><TextBlock x:Name="TaskLimitations"/>
      <WrapPanel Margin="0,18,0,0"><Button Content="View original control" Click="Reference_Click"/><Button x:Name="CheckSelected" Content="Check selected only" Click="CheckSelected_Click" IsEnabled="False"/><Button x:Name="ProtectedRead" Content="Read with administrator" Click="ProtectedRead_Click" IsEnabled="False"/><Button x:Name="ReviewFix" Content="Configure" Click="ReviewFix_Click" IsEnabled="False"/></WrapPanel>
      <Button x:Name="DiagnosticChange" Content="Review change" Click="DiagnosticReviewChange_Click" HorizontalAlignment="Left" Margin="0,12"/><TextBlock x:Name="ObservedAt" Margin="0,8"/><TextBlock Text="Observed evidence" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBox x:Name="Observations" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" MinHeight="100" AutomationProperties.Name="Observed check values and limitations"/>
     </StackPanel></ScrollViewer>
    </Grid>
    <DataGrid x:Name="SetupRows" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" SelectionChanged="SetupTask_Changed" HeadersVisibility="Column" MinHeight="240" AutomationProperties.Name="Setup tasks and individual selections" Visibility="Collapsed" EnableRowVirtualization="False" ColumnHeaderHeight="36" RowHeight="46" ScrollViewer.HorizontalScrollBarVisibility="Auto">
     <DataGrid.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="ToolTip" Value="{Binding Text,RelativeSource={RelativeSource Self}}"/></Style></DataGrid.Resources>
     <DataGrid.Columns>
      <DataGridTemplateColumn Header="Select" Width="58" MinWidth="58"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Click="Selection_Changed" AutomationProperties.Name="Select this task" Margin="12,10"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Header="Task" Binding="{Binding Definition.Title}" Width="2*" MinWidth="220" IsReadOnly="True"/>
      <DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="*" MinWidth="115" IsReadOnly="True"/>
      <DataGridTextColumn Header="Expected" Binding="{Binding Expected}" Width="*" MinWidth="115" IsReadOnly="True"/>
      <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" MinWidth="100" IsReadOnly="True"/>
      <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="*" MinWidth="125" IsReadOnly="True"/>
      <DataGridTextColumn Header="Action" Binding="{Binding ActionLabel}" Width="100" MinWidth="100" IsReadOnly="True"/>
      <DataGridTemplateColumn Header="Inputs" Width="100" MinWidth="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Configure" Click="ConfigureRow_Click" IsEnabled="{Binding NeedsInputs}" Padding="5" Margin="2"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
    <WrapPanel Grid.Row="3" Visibility="{Binding Visibility,ElementName=SetupRows}" Margin="0,10,0,0"><Button Content="Task details" Click="TaskDetails_Click"/><Button Content="Configure selected" Click="ReviewFix_Click" IsEnabled="{Binding IsEnabled,ElementName=ReviewFix}"/><Button Content="Original control" Click="Reference_Click"/><Button Content="Read with administrator" Click="ProtectedRead_Click" IsEnabled="{Binding IsEnabled,ElementName=ProtectedRead}"/><Button Content="Check selected only" Click="CheckOnly_Click"/><TextBlock Text="Selected changes run only after review." VerticalAlignment="Center"/></WrapPanel>
   </Grid>
   <Grid x:Name="DeploymentPanel" Grid.Row="2" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="The queue is shared by setup and diagnostics. Review exact targets and before values before applying changes." Margin="0,0,0,12"/><WrapPanel><Button Content="Choose application deployment" Click="OpenApplications_Click"/><Button Content="Choose Windows setting" Click="OpenWindowsSettings_Click"/></WrapPanel></StackPanel><ListBox Grid.Row="1" x:Name="QueueList" AutomationProperties.Name="Deployment queue"/><StackPanel Grid.Row="2"><WrapPanel Margin="0,16,0,0"><Button x:Name="ReviewQueue" Content="Review queue" Click="ReviewQueue_Click"/><Button x:Name="RemoveQueued" Content="Remove selected" Click="RemoveQueued_Click"/><Button x:Name="ClearQueue" Content="Clear queue" Click="ClearQueue_Click"/></WrapPanel><TextBox x:Name="RunResults" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Deployment outcomes and executing accounts"/></StackPanel></Grid>
   <ScrollViewer x:Name="ReportPanel" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="900" HorizontalAlignment="Left">
    <TextBlock Text="Build a report from saved evidence" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Open saved reports to select captures, runs and recorded reviews. The report keeps their actual dates and execution accounts visible." Margin="0,12,0,20"/>
    <TextBlock Text="Setup handover" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Review all 30 build controls, outstanding checks, exclusions and engineer verification before handing over a device." Margin="0,6,0,18"/>
    <TextBlock Text="Diagnostic ticket" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Export selected findings, observed values and their sources for investigation or a support ticket." Margin="0,6,0,18"/>
    <TextBlock Text="Deployment audit" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Inspect the reviewed plan, before and after evidence, actual execution account, restarts and uncertain outcomes. A completion review preserves the original run." Margin="0,6,0,18"/>
    <WrapPanel><Button Content="Open saved reports &amp; history" Click="History_Click"/><Button Content="Export last capture JSON" Click="Export_Click"/></WrapPanel>
    <TextBlock Text="Reports export to HTML, CSV or JSON. Manual reviews stay distinct from automatic checks; stale or unavailable evidence cannot prove current compliance." Margin="0,12"/>
   </StackPanel></ScrollViewer>
  </Grid>
  </ScrollViewer>
 </DockPanel>
</Window>
