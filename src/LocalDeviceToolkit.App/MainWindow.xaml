<Window x:Class="LocalDeviceToolkit.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Local Device Toolkit" Width="1280" Height="860" MinWidth="1000" MinHeight="680">
 <DockPanel>
  <Border DockPanel.Dock="Top" Padding="24,18" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="LOCAL DEVICE TOOLKIT" FontWeight="Bold" FontSize="22"/><TextBlock x:Name="DeviceHeader" Margin="0,6,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="20,0,0,0"><TextBlock x:Name="StandardHeader"/><TextBlock Text="Local Windows device • engineer session" Margin="0,6,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Border DockPanel.Dock="Bottom" Padding="20,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusLine" Text="Ready. Select a workspace; checks run only when requested." VerticalAlignment="Center"/><Button Grid.Column="1" x:Name="QueueShortcut" Content="Deployment queue (0)" Click="Queue_Click" Margin="12,0,0,0"/></Grid>
  </Border>
  <Border DockPanel.Dock="Left" Width="195" Padding="14,24" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
   <StackPanel><TextBlock Text="WORKSPACES" FontWeight="SemiBold" Margin="10,0,0,16"/><Button Content="_Home" Tag="home" Click="Navigate_Click"/><Button Content="New device _setup" Tag="setup" Click="Navigate_Click"/><Button Content="_Diagnostics" Tag="diagnostics" Click="Navigate_Click"/><Button Content="Deplo_yments" Tag="deployments" Click="Navigate_Click"/><Button Content="_Reports &amp; history" Tag="reports" Click="Navigate_Click"/><Separator Margin="0,16"/><TextBlock Text="Checks collect evidence. Changes require a reviewed plan." Margin="10,0"/><TextBlock x:Name="SessionNotice" Margin="10,20,0,0"/></StackPanel>
  </Border>
  <Grid Margin="24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel><TextBlock x:Name="PageTitle" Text="Your device workspace" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageDescription" Margin="0,8,0,18"/></StackPanel>
   <ProgressBar x:Name="Busy" Grid.Row="1" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,12"/>
   <ScrollViewer x:Name="HomePanel" Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760" HorizontalAlignment="Left">
    <Border BorderThickness="1" Padding="24" Margin="0,0,0,18" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"><StackPanel><TextBlock Text="Set up a new device" FontSize="22" FontWeight="SemiBold"/><TextBlock Margin="0,12" Text="Identify the device, assess the build standard, configure Windows, deploy approved applications and collect handover evidence."/><Button Content="Open new device setup" Tag="setup" Click="Navigate_Click" HorizontalAlignment="Left"/></StackPanel></Border>
    <Border BorderThickness="1" Padding="24" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"><StackPanel><TextBlock Text="Investigate an existing device" FontSize="22" FontWeight="SemiBold"/><TextBlock Margin="0,12" Text="Check device health, security, applications and user settings. Review the same fixes and deployment queue used during setup."/><Button Content="Open diagnostics" Tag="diagnostics" Click="Navigate_Click" HorizontalAlignment="Left"/></StackPanel></Border>
    <TextBlock Margin="0,20" Text="Both workspaces use one task catalogue and shared evidence. Manual and unavailable checks remain visible; opening a page never changes the device."/>
   </StackPanel></ScrollViewer>
   <Grid x:Name="WorkflowPanel" Grid.Row="2" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel><TextBlock x:Name="StageProgress" Margin="0,0,0,10"/><ComboBox x:Name="Stages" DisplayMemberPath="Title" SelectionChanged="Stage_Changed" AutomationProperties.Name="Workflow stage" Margin="0,0,0,12"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Search" TextChanged="Search_Changed" AutomationProperties.Name="Find tasks by title or control ID" ToolTip="Find tasks by title or control ID" Margin="0,0,12,0"/><Button Grid.Column="1" x:Name="CheckStage" Content="Check stage" Click="CheckStage_Click" Margin="0"/></Grid>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" MinWidth="300"/><ColumnDefinition Width="20"/><ColumnDefinition Width="1*" MinWidth="300"/></Grid.ColumnDefinitions>
     <ListBox x:Name="TaskList" SelectionChanged="Task_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Shared toolkit tasks">
      <ListBox.ItemTemplate><DataTemplate><Border Padding="10,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"><StackPanel><TextBlock Text="{Binding Definition.Title}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding Status}" Margin="0,6,0,0"/><TextBlock Text="{Binding Summary}" FontSize="12" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock x:Name="TaskTitle" Text="Select a task" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="TaskIds" Margin="0,8,0,14"/><TextBlock x:Name="TaskRequirement"/><TextBlock Text="Local coverage and verification" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8"/><TextBlock x:Name="TaskLimitations"/>
      <WrapPanel Margin="0,18,0,0"><Button Content="View original control" Click="Reference_Click"/><Button x:Name="CheckSelected" Content="Check selected task" Click="CheckSelected_Click" IsEnabled="False"/><Button x:Name="ProtectedRead" Content="Read with administrator" Click="ProtectedRead_Click" IsEnabled="False"/><Button x:Name="ReviewFix" Content="Review fix" Click="ReviewFix_Click" IsEnabled="False"/></WrapPanel>
      <TextBlock x:Name="ObservedAt" Margin="0,8"/><TextBlock Text="Observed evidence" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBox x:Name="Observations" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" MinHeight="100" AutomationProperties.Name="Observed check values and limitations"/>
     </StackPanel></ScrollViewer>
    </Grid>
   </Grid>
   <Grid x:Name="DeploymentPanel" Grid.Row="2" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="The queue is shared by setup and diagnostics. Each change needs fresh before-state evidence and a review; identical requests appear once." Margin="0,0,0,16"/><ListBox Grid.Row="1" x:Name="QueueList" AutomationProperties.Name="Deployment queue"/><StackPanel Grid.Row="2"><WrapPanel Margin="0,16,0,0"><Button x:Name="ReviewQueue" Content="Review queue" Click="ReviewQueue_Click"/><Button x:Name="RemoveQueued" Content="Remove selected" Click="RemoveQueued_Click"/><Button x:Name="ClearQueue" Content="Clear queue" Click="ClearQueue_Click"/></WrapPanel><TextBox x:Name="RunResults" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Deployment outcomes and executing accounts"/></StackPanel></Grid>
   <Grid x:Name="ReportPanel" Grid.Row="2" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><Button Content="Load history" Click="History_Click"/><Button Content="Export capture JSON" Click="Export_Click"/></WrapPanel><TextBox Grid.Row="1" x:Name="HistoryText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Evidence history"/></Grid>
  </Grid>
 </DockPanel>
</Window>
